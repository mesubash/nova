# Required
GEMINI_API_KEY=
# Example: gemini-3.5-flash-lite (see docs/decisions.md)
GEMINI_MODEL=

# Optional (defaults shown)
# NOVA_REQUEST_TIMEOUT=30
# NOVA_MAX_HISTORY_TURNS=10
# NOVA_MAX_RECORDING_SECONDS=30
# Desktop actions (optional)
# NOVA_ALLOWED_APPS=Safari,Notes,Calendar,Music,Calculator,TextEdit,Finder
# NOVA_SEARCH_FOLDER=~/Documents

# Personal notes (optional)
# NOVA_DATA_DIR=~/Library/Application Support/NOVA

# Transcription (optional): gemini (default) or local (needs: pip install -e ".[local]")
# NOVA_TRANSCRIBER=gemini
# NOVA_LOCAL_MODEL=mlx-community/whisper-large-v3-turbo
